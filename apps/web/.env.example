# Proveedor del mapa base: 'osm' (defecto rápido sin clave), 'pmtiles' (autoalojado) u 'openfreemap'
VITE_BASEMAP=osm

# Ruta o URL al archivo PMTiles de Piura (en dev '/tiles/piura.pmtiles'; en prod URL de CloudFront / S3)
VITE_BASEMAP_PMTILES_URL=/tiles/piura.pmtiles

# Habilitar perfiles de acceso rápido en la pantalla de login (true en desarrollo)
VITE_DEMO_MODE=true

# URL base de la API backend (por defecto /api proxied por Vite)
VITE_API_URL=/api
