NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=cambia-esto-por-un-secreto-de-32-caracteres-o-mas

# mock = identidad, incidentes y auditoría en memoria (5 000 registros INDECI sintéticos)
# postgres = TypeORM + PostgreSQL/PostGIS (correr antes: pnpm migration:run && pnpm db:seed)
DATA_DRIVER=mock
MOCK_DATASET_PATH=./data/indeci-piura.json
DATABASE_URL=postgresql://geoalert:geoalert@localhost:5432/geoalert
DATABASE_SSL=false
DATABASE_LOGGING=false

# inprocess = Socket.io en el mismo proceso | redis = Lambda publica vía Redis al servidor realtime
REALTIME_DRIVER=inprocess
REDIS_URL=redis://localhost:6379

# local = ./var/media servido en /media | s3 = bucket privado detrás de CloudFront
PHOTO_DRIVER=local
PHOTO_PUBLIC_BASE_URL=/media
S3_BUCKET=

# Datos guía de riesgo histórico (relativo a apps/api)
RISK_DATASET_PATH=../../data/indeci_historico_piura.json
