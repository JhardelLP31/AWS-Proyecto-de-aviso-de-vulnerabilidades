// GeoAlert / ResQMap — modelo de datos
// PostGIS: la columna `location` es una columna GENERADA a partir de lat/lng
// (ver migrations/0001_init/migration.sql). Prisma escribe lat/lng y Postgres
// mantiene la geometría y su índice GIST sin que la app tenga que tocarla.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"] // rhel-openssl-3.0.x = runtime Node 20/22 de Lambda
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ─── Identidad y RBAC (estilo Spatie) ─────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String
  phone        String?
  district     String?
  /// w_u del motor de veracidad. 1.0 = vecino nuevo. Se recalcula según acierto histórico.
  reputation   Float    @default(1.0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles         UserRole[]
  permissions   UserPermission[]
  incidents     Incident[]             @relation("IncidentReporter")
  confirmations IncidentConfirmation[]
  auditLogs     AuditLog[]
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique // vecino | brigadista | defensa_civil | admin
  description String?
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique // 'incidents.verify', 'triage.update', 'incidents.*'
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
  users       UserPermission[]
}

model UserRole {
  userId    String   @db.Uuid
  roleId    Int
  grantedAt DateTime @default(now())
  grantedBy String?  @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// Permiso directo al usuario (equivalente a `givePermissionTo` de Spatie).
model UserPermission {
  userId       String     @db.Uuid
  permissionId Int
  grantedAt    DateTime   @default(now())
  expiresAt    DateTime?  // p. ej. acceso temporal durante una emergencia
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
}

// ─── Incidentes ────────────────────────────────────────────────────────────────

enum IncidentType {
  RIVER_OVERFLOW
  BLIND_BASIN_COLLAPSE
  DIKE_BREACH
  ISOLATED_AREA
  FLOODED_ROAD
  LANDSLIDE
  OTHER
}

enum Severity {
  GREEN
  YELLOW
  ORANGE
  RED
}

enum IncidentStatus {
  PENDING
  VERIFIED
  DISMISSED
  RESOLVED
}

enum IncidentSource {
  CITIZEN
  BRIGADE
  INDECI_IMPORT
}

enum VoteKind {
  CONFIRM
  DENY
}

model Incident {
  id            String                   @id @default(uuid()) @db.Uuid
  type          IncidentType
  severity      Severity
  status        IncidentStatus           @default(PENDING)
  title         String                   @db.VarChar(120)
  description   String                   @db.VarChar(2000)
  lat           Float
  lng           Float
  /// geometry(Point, 4326) GENERATED ALWAYS AS (ST_SetSRID(ST_MakePoint(lng, lat), 4326)) STORED
  location      Unsupported("geometry(Point, 4326)")?
  district      String?
  veracityScore Float                    @default(0)
  confirmCount  Int                      @default(0)
  denyCount     Int                      @default(0)
  source        IncidentSource           @default(CITIZEN)
  /// Código del registro original en INDECI / GeoSINPAD (idempotencia de importación).
  externalRef   String?                  @unique
  reporterId    String?                  @db.Uuid
  reporter      User?                    @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  occurredAt    DateTime
  verifiedAt    DateTime?
  resolvedAt    DateTime?
  /// Bloqueo optimista para cambios de triaje concurrentes.
  version       Int                      @default(0)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  photos        IncidentPhoto[]
  confirmations IncidentConfirmation[]

  @@index([status, severity])
  @@index([district, status])
  @@index([occurredAt])
}

model IncidentPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @db.Uuid
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  storageKey String   // clave en S3 (o ruta local en desarrollo)
  mimeType   String   // image/webp (image/jpeg solo como respaldo para Safari antiguo)
  width      Int
  height     Int
  bytes      Int
  sha256     String
  createdAt  DateTime @default(now())

  @@index([incidentId])
}

/// Un voto por usuario e incidente (UNIQUE). Cambiar de opinión = UPDATE, nunca un segundo voto.
model IncidentConfirmation {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @db.Uuid
  userId     String   @db.Uuid
  kind       VoteKind
  /// w_u congelado al momento del voto (auditabilidad del score).
  weight     Float
  isBrigade  Boolean  @default(false)
  /// Distancia medida en servidor entre el votante y el incidente (geocerca de 500 m).
  distanceM  Float
  lat        Float
  lng        Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incidentId, userId])
  @@index([userId])
}

// ─── Auditoría forense ─────────────────────────────────────────────────────────

/// Append-only. La migración revoca UPDATE/DELETE sobre esta tabla al rol de la app.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // 'incidents.vote', 'triage.update', 'auth.login.failed'
  resource   String   // 'incident', 'user', 'role'
  resourceId String?
  ip         String?
  userAgent  String?
  statusCode Int?
  /// { before: {...} | null, after: {...} | null }
  changes    Json?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([userId, createdAt])
  @@index([createdAt])
}
